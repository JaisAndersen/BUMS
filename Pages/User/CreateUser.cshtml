@page
@model BUMS.CreateUserModel
@{
    ViewData["Title"] = "Create User";
}

<h1>Create a new user </h1>

@if(@Model.UserModel != null){
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="  ModelOnly  " class="text-danger">
            </div>
            <div class="form-group">
                <label asp-for="@Model.UserModel.UserName" class="control-label"></label>
                <input asp-for="@Model.UserModel.UserName" class="form-control" />
                <span asp-validation-for="@Model.UserModel.UserName" class="text-danger"></span>
            </div>    
            <div class="form-group">
                <label asp-for="@Model.UserModel.Email" class="control-label"></label>
                <input asp-for="@Model.UserModel.Email" class="form-control" />
                <span asp-validation-for="@Model.UserModel.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="@Model.UserModel.Password"></label>
                <input asp-for="@Model.UserModel.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <span asp-validation-for="@Model.UserModel.Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="@Model.UserModel.ConfirmPassword"></label>
                <input asp-for="@Model.UserModel.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <span asp-validation-for="@Model.UserModel.ConfirmPassword" class="text-danger"></span>
            </div>
            <p></p>
            <div class="form-group">
                <input type="submit" value="Create" class="btn custom-btn" />
            </div>
        </form>
    </div>
</div>
}
