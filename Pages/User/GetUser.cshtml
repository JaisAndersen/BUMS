@page
@model BUMS.GetUserModel
@inject IUserService service
@inject IGroupService gService
@{
ViewData["Title"] = "Users";
}

<h3>List of Users</h3>
@if (Model.IsAdmin){
<p>
    <a asp-page="/User/CreateUser">Create New User</a>
</p>
}
<form>
    <p>
        Search: <input type="text" asp-for="FilterCriteria" />
        <input type="submit" value="Filter" />
        <a asp-page="/User/GetUser" asp-route-id="@HttpContext.User.Identity.Name">Back to Full List </a>
    </p>
</form>
<table class="table">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Name</th>
            <th>Email</th>
            @if (Model.IsAdmin){
            <th>Created At</th>
            <th>Created By</th>
            <th>Updated At</th>
            <th>Updated By</th>
            <th></th>
            <th></th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null){
        @foreach (User user in Model.Users){
        <tr>
            <td>@user.UserNavigationID</td>
            <td>@user.UserName</td>
            <td>@user.Email</td>
            @if (Model.IsAdmin){
            <td>@user.CreatedAt</td>

            <td>@user.CreatedBy</td>
            @if(@user.UpdatedAt != new DateTime(0001,01,01)){
            <td>@user.UpdatedAt</td>
            <td>@user.UpdatedBy</td>
            }
            else{
            <td>@Model.UserGroups</td>
            <td></td>
            }
            }
            @if(Model.GId == 0){
            <td>
                <a asp-page="/User/ShowUserGroup" asp-route-uid="@user.Id"> See groups </a>
            </td>
            }
            @if (Model.IsAdmin){
            <td>
                @{
                var routeValues = new Dictionary<string, string>();
                    routeValues.Add("gid", Model.GId.ToString());
                    routeValues.Add("uid", user.Id);
                    }

                    @if (Model.GId != 0){
                    <a asp-page="/UserGroup/CreateUserGroup" asp-all-route-data="routeValues">Add this user to the group</a>
                    }
            </td>
            @if (Model.GId == 0){
            <td>
                <p>
                    <a asp-page="/User/UpdateUser" asp-route-id="@user.Id">Edit</a>
                </p>
            </td>
            <td>
                <p>
                    <a asp-page="/User/DeleteUser" asp-route-id="@user.Id">Delete</a>
                </p>
            </td>
            }
            }
        </tr>
        }
        }
</table>
