@page
@model BUMS.ShowUserGroupModel
@inject IGroupService GroupService
@{
}

<h3 style="color:black">Groups @Model.UserModel is part of</h3>
<div>
    <dl class="row">     
        <dd class="col-sm-10">
            <table class="table">
                <thead>
                    <tr>
                        <th>Group Name</th>
                        <th>UserGroup</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (UserGroup ug in Model.UserModel?.UserGroup ?? Enumerable.Empty<UserGroup>()) {
                    <tr>
                            @if(ug.Group != null){
                            <td>@Html.DisplayFor(modelItem => ug.Group.GroupName ?? "No Group Name")</td>
                            <td>@ug.UserGroupID</td>
                            }
                    </tr>
                    }
                </tbody>
            </table>
            @if (Model.IsAdmin) {
            <p>
                Add user to a group? Please Click here:
                @if(Model.UserModel != null){
                <a asp-page="/Group/GetGroup" asp-route-uid="@Model.UserModel.Id">Add to a group</a>
                }
            </p>
            }
        </dd>
    </dl>
</div>

