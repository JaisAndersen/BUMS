@page
@model BUMS.DeleteUserModel
@{
    ViewData["Title"] = "Delete User";
}

<div>
    <hr />
    <form method="post">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.user?.UserNavigationID</td>
                    <td>@Model.user?.UserName</td>
                    <td>@Model.user?.Email</td>
                </tr>
            </tbody>
        </table>
        <input type="hidden" asp-for="user.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
    </form>
</div>
