@page
@model BUMS.GetGroupModel
@{
ViewData["Title"] = "Groups";
}

<h3>List of Groups</h3>
<div>
    @if (Model?.IsAdmin == true) {
    <p>
        <a asp-page="/Group/CreateGroup">Create New Group</a>
    </p>
    }
    <form>
        <p>
            Search: <input type="text" asp-for="FilterCriteria" />
            <input type="submit" value="Filter" />
            <a asp-page="/User/GetUser">Back to Full List</a>
        </p>
    </form>
    <table class="table">
        <thead>
            <tr>
                <th>Group ID</th>
                <th>Name</th>
                <th>Access</th>
                <th>Created At</th>
                <th>Created By</th>
                <th>Updated At</th>
                <th>Updated By</th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model?.Groups != null) {
            @foreach (var group in Model.Groups) {
            <tr>
                <td>@group?.GroupID</td>
                <td>@group?.GroupName</td>
                <td>@group?.AccessID</td>
                <td>@group?.CreatedAt</td>
                <td>@group?.CreatedBy</td>

                @if (group?.UpdatedAt != new DateTime(0001, 01, 01)) {
                <td>@group?.UpdatedAt</td>
                <td>@group?.UpdatedBy</td>
                }
                else {
                <td></td>
                <td></td>
                }
                <td>
                    <p>
                        @if (Model?.IsAdmin == true) {
                        @if (Model?.UId == null) {
                        <a asp-page="/User/GetUser" asp-route-gid="@group?.GroupID">Add a user to this group</a>
                        }
                        else if (!string.IsNullOrEmpty(Model?.UId)) {
                        var routeValues = new Dictionary<string, string>
                            {
                            { "uid", Model?.UId! },
                            { "gid", group?.GroupID.ToString()! }
                            };
                            <a asp-page="/UserGroup/CreateUserGroup" asp-all-route-data="routeValues">Add user to this group</a>
                            }
                            }
                    </p>
                </td>
                @if (Model?.IsAdmin == true || Model?.UId == null) {
                <td>
                    <p>
                        <a asp-page="/Group/UpdateGroup" asp-route-id="@group?.GroupID">Edit</a>
                    </p>
                </td>
                <td>
                    <p>
                        <a asp-page="/Group/DeleteGroup" asp-route-id="@group?.GroupID">Delete</a>
                    </p>
                </td>
                }
            </tr>
            }
            }
        </tbody>
    </table>
</div>
