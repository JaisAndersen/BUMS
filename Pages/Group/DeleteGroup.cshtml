@page
@model BUMS.DeleteGroupModel
@using BUMS
@inject IGroupService service
@{
ViewData["Title"] = "Delete Group";
}
<div>
    <hr/>
    @if(@Model?.Group != null){
    <form method="post">
        <table>
            <thead>
                <tr>
                    <th>Group ID</th>
                    <th>Group Name</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@Model.Group.GroupID</td>
                    <td>@Model.Group.GroupName</td>
                </tr>
            </tbody>
        </table>
        <input type="hidden" asp-for="Group.GroupID"/>
        <input type="submit" value="Delete" class="btn btn-danger"/>
    </form>
    }
</div>
