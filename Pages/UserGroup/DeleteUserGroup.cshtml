@page
@model BUMS.DeleteUserGroupModel
@inject IGroupService gService
@{
    ViewData["Title"] = "Delete UserGroup";
}
<div>
    @if(Model.UserGroup != null){
    <div class="container">
        <form method="post">
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Group</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@Model.UserGroup?.UserGroupID </td>
                        <td>@Model.GetGroup(@Model.UserGroup?.GroupID ?? 0)?.GroupName</td>
                    </tr>
                </tbody>
            </table>
            <input type="hidden" asp-for="UserGroup.UserGroupID"/>
            <input type="submit" value="Delete" class="btn btn-danger"/>
        </form>
    </div>
    }
</div>
