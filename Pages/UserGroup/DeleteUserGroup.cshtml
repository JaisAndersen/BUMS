@page
@model BUMS.DeleteUserGroupModel
@{
    ViewData["Title"] = "Delete UserGroup";
}
<div>
    <form method="post">
        <dl class="row">
            <dt class="col-sm-2">  @Html.DisplayNameFor(model => model.UserGroup.UserGroupID)   </dt>
            <dd class="col-sm-10">  @Model.UserGroup.UserGroupID  </dd>
        </dl>
        <input type="hidden" asp-for="UserGroup.UserGroupID"/>
        <input type="submit" value="Delete" class="btn btn-danger"/>
    </form>
</div>
